#!/bin/bash
set -euo pipefail

if [ "$#" -ne 2 ]; then
  echo "Usage: $0 <server_ip> <server_port>" >&2
  exit 1
fi

project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
requested_cctv_id="${UTIC_CCTV_ID:-}"
if [ -f "$project_dir/.env" ]; then
  set -a
  source "$project_dir/.env"
  set +a
fi

if [ -z "${UTIC_API_KEY:-}" ]; then
  echo "UTIC_API_KEY is missing; configure the local .env file" >&2
  exit 1
fi
export UTIC_API_KEY
export UTIC_CCTV_ID="${requested_cctv_id:-${UTIC_CCTV_ID:-L010009}}"

binary="${EDGE_VISION_BIN:-$project_dir/build-cctv/bin/edge_vision}"
if [ ! -x "$binary" ]; then
  echo "Build edge_vision first or set EDGE_VISION_BIN" >&2
  exit 1
fi

export DISPLAY="${EDGE_VISION_DISPLAY:-:1}"
export XAUTHORITY="${XAUTHORITY:-/home/jetson/.Xauthority}"
exec "$binary" "$1" "$2"
